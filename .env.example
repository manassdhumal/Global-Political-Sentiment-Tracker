# =====================================================================
# Global Political Sentiment Tracker — environment / credentials
# Copy this file to `.env` and fill in your keys. `.env` is git-ignored;
# NEVER commit real credentials.
#
# Everything runs on synthetic fallback data WITHOUT these. Set the switch
# below + at least one real source to pull LIVE data.
# =====================================================================

# ---- THE SWITCH: where topic analysis gets its data ----
# 'synthetic' (default) | 'auto' (try real sources, fall back per-piece).
# Only set to 'auto' once at least one real source below is configured,
# otherwise media analysis is slow (it tries GDELT, then falls back).
GPST_TOPIC_SOURCE=synthetic

# ---- Media tone: GDELT BigQuery (real, no rate limits, full history) ----
# 1) Create a Google Cloud project. 2) `pip install google-cloud-bigquery`.
# 3) Authenticate: `gcloud auth application-default login` (or a service
#    account key via GOOGLE_APPLICATION_CREDENTIALS). 4) Set the project id:
GPST_BQ_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GPST_BQ_MAX_GB=8          # caps BigQuery bytes billed per query

# ---- Public/social sentiment: Reddit ----
# reddit.com/prefs/apps -> "create app" -> type "script".
#   client id  = the string under the app name
#   secret     = the "secret" field
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gpst:v3 (by /u/yourname)

# ---- Public/social sentiment: Bluesky ----
# bsky.app -> Settings -> Privacy & Security -> App Passwords -> Add.
BLUESKY_HANDLE=            # e.g. yourname.bsky.social
BLUESKY_APP_PASSWORD=      # the app password, NOT your main password

# ---- Optional: sentiment model for scoring opinion text ----
# 'transformers' uses local RoBERTa (needs torch); 'vader' is the fast fallback.
GPST_SENTIMENT_BACKEND=transformers

# ---- Optional: LLM-written topic narratives ----
# GPST_NARRATIVE=anthropic
# ANTHROPIC_API_KEY=

# ---- Optional: shared trending cache (deployment) ----
# GPST_REDIS_URL=redis://localhost:6379/0
