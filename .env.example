# =====================================================================
# Global Political Sentiment Tracker — environment / credentials
# Copy this file to `.env` and fill in your keys. `.env` is git-ignored;
# NEVER commit real credentials.
#
# Everything runs on synthetic fallback data WITHOUT these — you only
# need them to pull LIVE public-opinion data.
# =====================================================================

# ---- Reddit (https://www.reddit.com/prefs/apps -> create a "script" app) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gpst:v2 (by /u/yourname)

# ---- Bluesky (Settings -> App Passwords -> create one) ----
BLUESKY_HANDLE=            # e.g. yourname.bsky.social
BLUESKY_APP_PASSWORD=      # the app password, NOT your main password

# ---- Optional: sentiment backend for opinion text ----
# 'transformers' uses local RoBERTa (recommended); 'vader' is the fast fallback.
GPST_SENTIMENT_BACKEND=transformers
# Override the RoBERTa model if you like:
# GPST_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
